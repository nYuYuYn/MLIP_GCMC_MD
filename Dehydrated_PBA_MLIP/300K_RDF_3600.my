# 1) Initialization
units metal
boundary p p p
atom_style atomic
variable T equal 300
variable N equal 3600
# 2) System definition
read_data Na_3600_300K.data
mass 1 12.10 # C
mass 2 54.94 # Mn
mass 3 55.85 # Fe
mass 4 14.01 # N
mass 5 22.99 # Na
variable seed index 31755

# 3) Simulation settings
group Na type 5
group C type 1
group Mn type 2
group Fe type 3
group N type 4
group PB type 1 2 3 4 
pair_style mlip load_from=curr.almtp
pair_coeff  * *

delete_atoms overlap 0.1 all all
variable sodium atom "type==5"
group sodium dynamic all var sodium
variable nNa equal count(sodium)

# 4) Visualization
log ${T}K_RDF_${N}.log
dump dump all custom 1000 ${T}K_RDF_${N}.trj id type x y z
restart 50000 ${T}K_RDF_${N}_restart

# 5) Run
reset_atoms id sort yes
neighbor        2 bin
neigh_modify    every 5 delay 5 check yes

velocity all create ${T} ${seed} mom yes rot yes dist gaussian
compute_modify thermo_temp dynamic yes
compute ctNa Na temp
compute ctPB PB temp
compute_modify ctNa dynamic/dof yes
compute_modify ctPB dynamic/dof yes

variable dt equal 0.0005 

#python check_equilibrium_lmp file equilibrium_check.py

fix mynpt1 all npt temp ${T} ${T} $(200.0*dt) tri 1 1 $(2000.0*dt)
timestep 0.001
thermo 500
thermo_style custom step temp etotal press vol v_nNa atoms


delete_atoms overlap 0.5 all all
# 5) RDF & Coordination number
compute myRDF all rdf 100 1 3 1 4 4 2 4 5 2 3
fix rdf_output all ave/time 5 200 10000 c_myRDF[*] file ${T}K_rdf_final_${N}.rdf mode vector

# Compute Fe-C and Mn-N coordination numbers
compute FeCcoord Fe coord/atom cutoff 3.5 group C
compute MnNcoord Mn coord/atom cutoff 3.5 group N
compute NaNcoord Na coord/atom cutoff 3.5 group N

# Output RDF and coordination numbers at the final timestep
dump FeC_dump Fe custom 5000 ${T}K_FeC_coord_${N}.txt id type c_FeCcoord
dump MnN_dump Mn custom 5000 ${T}K_MnN_coord_${N}.txt id type c_MnNcoord
dump NaN_dump Na custom 5000 ${T}K_NaN_coord_${N}.txt id type c_NaNcoord
run 20000

write_dump all custom ${T}K_RDF_${N}.dump id type x y z