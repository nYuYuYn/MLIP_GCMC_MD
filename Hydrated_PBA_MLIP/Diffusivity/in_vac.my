# 1) Initialization
units metal
boundary p p p
atom_style atomic
variable T equal 400

# 2) System definition
read_data MnFePBA_make_cfg_400.data

mass 1 12.0107  # C
mass 2 54.938049  # Mn
mass 3 55.845  # Fe
mass 4 14.0067  # N
mass 5 22.98977  # Na
mass 6 15.9994  # O
mass 7 1.00794  # H
variable seed index 789789
reset_timestep 0
# 3) Simulation settings
group O type 6
group PB type 1 2 3 4
group H2O type 6 7
group Na type 5
group N type 4
pair_style mlip load_from=curr.almtp
pair_coeff  * *

# check deleted atoms
delete_atoms overlap 0.1 all all

# 4) Visualization
restart 50000 restart.out

# 5) Run
reset_atoms id sort yes
neighbor        2 bin
neigh_modify    every 5 delay 5 check yes

velocity all create ${T} ${seed} mom yes rot yes dist gaussian
compute ctNa Na temp
compute cth2o H2O temp
compute ctPB PB temp
compute_modify ctNa dynamic/dof yes
compute_modify cth2o dynamic/dof yes
compute_modify ctPB dynamic/dof yes
variable dt equal 0.0005 

variable xlo_init equal xlo+0.5
variable xhi_init equal xhi-0.5
variable ylo_init equal ylo+0.5
variable yhi_init equal yhi-0.5
variable zlo_init equal zlo+0.5
variable zhi_init equal zhi-0.5
variable xy_init equal xy
variable xz_init equal xz
variable yz_init equal yz
region system prism ${xlo_init} ${xhi_init} ${ylo_init} ${yhi_init} ${zlo_init} ${zhi_init} ${xy_init} ${xz_init} ${yz_init}

fix mynpt1 all npt temp ${T} ${T} $(200.0*dt) tri 1 1 $(2000.0*dt)
fix 1 all recenter INIT INIT INIT
timestep 0.0005
thermo 500
thermo_style custom step temp etotal press vol
run 40000

compute myRDF all rdf 100 1 3 1 4 4 2 4 5 2 3 6 5 6 7
fix rdf_output all ave/time 50 20 4000 c_myRDF[*] file RDF/300K_rdf_Na_32_O_16.rdf mode vector
compute ONacoord O coord/atom cutoff 2.4 group Na
compute NaNcoord Na coord/atom cutoff 3.3 group N
dump ONa_dump O custom 4000 RDF/${T}K_ONa_coord_${Na}_${O}.txt id type c_ONacoord
dump NaN_dump Na custom 4000 RDF/${T}K_NaN_coord_${Na}_${O}.txt id type c_NaNcoord
run 12000

write_data RDF_lv12_E0/Na_${Na}_O_${O}_${M}.data
write_dump all custom RDF_lv12_E0/Na_${Na}_O_${O}_${M}.dump id type x y z

unfix rdf_output
undump ONa_dump
undump NaN_dump
uncompute myRDF
uncompute ONacoord
uncompute NaNcoord

compute msd_h2o H2O msd com yes
compute msd_PB PB msd com yes
compute msd_Na Na msd com yes

fix avg_msd_PB PB ave/time 1000 10 10000 c_msd_PB[1] c_msd_PB[2] c_msd_PB[3] c_msd_PB[4] file 400K_msd_PB_8.dat mode scalar 
fix avg_msd_Na Na ave/time 1000 10 10000 c_msd_Na[1] c_msd_Na[2] c_msd_Na[3] c_msd_Na[4] file 700K_msd_Na_8.dat mode scalar
fix avg_msd_h2o Na ave/time 1000 10 10000 c_msd_h2o[1] c_msd_h2o[2] c_msd_h2o[3] c_msd_h2o[4] file 700K_msd_h2o_8.dat mode scalar 

timestep 0.001
thermo 500
thermo_style custom step temp etotal press vol atoms c_msd_PB[4] c_msd_Na[4] c_msd_h2o[4]

dump dump_short all custom 5 ${current_dir}/dump.${current_temp}_diffuse_short_${i}.trj id type x y z
run 10000
undump dump_short

dump dump all custom 1000 ${current_dir}/dump.${current_temp}_diffuse_${i}.trj id type x y z
dump dump_long all custom 4000 ${current_dir}/dump.${current_temp}_diffuse_long_${i}.trj id type x y z

run 2000000
undump dump
run 8000000

# ) Save structure
write_data 400K_MnFePBA_diffusion_400.data